# Backend Environment Variables
# Copy this file to .env and fill in the values

# OpenRouter API Key (required for LLM chat, personalize, translate)
# Get yours at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# PostgreSQL Database URL (required for user profiles)
DATABASE_URL=postgresql://user:password@localhost:5432/physical_ai_textbook
